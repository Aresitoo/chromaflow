#!/bin/sh
# Parse + tag registration gate. Runs on every commit that touches the card,
# the build script or the checker. Silently skips when node is unavailable.
set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

changed=$(git diff --cached --name-only || true)
case "$changed" in
  *ares-energy-flow-card.js*|*make-dev-build.sh*|*check-tags.mjs*) ;;
  *) exit 0 ;;
esac

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, skipping card checks"
  exit 0
fi

node --check ares-energy-flow-card.js
node scripts/check-tags.mjs ares-energy-flow-card.js --expect prod

# Build the sandbox variant and check it too. The scratch file goes in the git dir,
# not .git/ by name: in a worktree .git is a file (a gitdir pointer), so a literal
# .git/ path is not a directory and the hook would abort every worktree commit.
# Ask git for the dir instead; it is absolute and node can open it.
gitdir=$(git rev-parse --git-dir)
bash tools/make-dev-build.sh ares-energy-flow-card.js "$gitdir/pre-commit-dev.js" >/dev/null
node scripts/check-tags.mjs "$gitdir/pre-commit-dev.js" --expect dev
rm -f "$gitdir/pre-commit-dev.js"

echo "pre-commit: card checks passed"
